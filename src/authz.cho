edition 5;

module authz;

import std.buffer;
import http.server;
import manage;
import std.http;

// `authz` -- who may call which route (`docs/design.md` section 33).
//
// Three tokens, three scopes, and every request goes through `judge` before its handler runs:
//
//     ingest   `POST /events` (and so its idempotent retries)
//     read     `GET /events/:id`, `/events/:id/attempts`, `/endpoints`, `/endpoints/:id`, `/endpoints/:id/dead`, `/stats`, `/config`, `/metrics`
//     admin    everything that changes configuration or state (endpoints, enable, replay, replay of dead letters, cancelling replays, schedules); it also satisfies read and ingest
//
// A scope whose token is not configured leaves its routes open, as they were before there were scopes (a development service needs none).
// The exception is the admin scope, where the handlers already answer `403` ("management is off") on the routes that have always needed
// the token. `GET /healthz` and `GET /readyz` are open whatever is configured. `production = 1` makes the service refuse to start without the admin and
// ingest tokens, and treats an unset read token as the admin token (`hooks.cho`, `main`).
//
// **Fail closed.** The table below is the one place a route gets its scope. A route that is declared in `api.cho` and has no line here is
// `unscoped()`: it needs the admin token, and with no admin token configured it is refused outright (`403`), never open. A test
// (`tests/authz_test.py`) lists every operation `src/api.cho` declares and fails if one has no line here or no row in its matrix, or if the scope
// the declaration documents for it is not the one this table enforces.
//
// The three tokens are kept in the delivery state one after another, 256 integers each (`manage.token_size()`): the admin token, then the
// ingest token, then the read token. A token is compared by `manage.authorize`, which looks at every byte of the longest token there can be
// whichever one differs first, so the comparison does not tell how much of a guess was right.

pub fn s_open() -> [] int {
    return 0;
}

pub fn s_ingest() -> [] int {
    return 1;
}

pub fn s_read() -> [] int {
    return 2;
}

pub fn s_admin() -> [] int {
    return 3;
}

pub fn s_unscoped() -> [] int {
    return 4;
}

// Where the three tokens are, relative to the admin token's offset in the delivery state.
pub fn tokens_size() -> [] int {
    return 3 * manage.token_size();
}

pub fn ingest_at() -> [] int {
    return manage.token_size();
}

pub fn read_at() -> [] int {
    return 2 * manage.token_size();
}

// THE TABLE. One entry for each operation `src/api.cho` declares, by the id `web.operation` gives it (1, 2, 3 ... in the order of the declarations):
// the scope, and (as the comment on that line) the method and path, which the test checks against the declaration. A new route is added HERE, on its
// own entry, after it is declared at the END of `api.declare`.
pub fn scope_of(id: int) -> [] int {
    if id == 1 {
        return s_open(); // GET /healthz
    }
    if id == 2 {
        return s_ingest(); // POST /events
    }
    if id == 3 {
        return s_read(); // GET /events/:id
    }
    if id == 4 {
        return s_read(); // GET /stats
    }
    if id == 5 {
        return s_read(); // GET /config
    }
    if id == 6 {
        return s_admin(); // POST /endpoints/:id/enable
    }
    if id == 7 {
        return s_read(); // GET /endpoints
    }
    if id == 8 {
        return s_admin(); // POST /events/:id/replay
    }
    if id == 9 {
        return s_admin(); // POST /events/:id/replay/:endpoint
    }
    if id == 10 {
        return s_read(); // GET /events/:id/attempts
    }
    if id == 11 {
        return s_admin(); // POST /endpoints
    }
    if id == 12 {
        return s_read(); // GET /endpoints/:id
    }
    if id == 13 {
        return s_admin(); // PATCH /endpoints/:id
    }
    if id == 14 {
        return s_admin(); // DELETE /endpoints/:id
    }
    if id == 15 {
        return s_admin(); // POST /schedules
    }
    if id == 16 {
        return s_admin(); // GET /schedules
    }
    if id == 17 {
        return s_admin(); // GET /schedules/:id
    }
    if id == 18 {
        return s_admin(); // PATCH /schedules/:id
    }
    if id == 19 {
        return s_admin(); // DELETE /schedules/:id
    }
    if id == 20 {
        return s_read(); // GET /endpoints/:id/dead
    }
    if id == 21 {
        return s_admin(); // POST /endpoints/:id/replay-dead
    }
    if id == 22 {
        return s_admin(); // DELETE /events/:id/replay/:endpoint
    }
    if id == 23 {
        return s_admin(); // DELETE /endpoints/:id/replays
    }
    if id == 24 {
        return s_admin(); // DELETE /events/:id
    }
    if id == 25 {
        return s_open(); // GET /readyz
    }
    if id == 26 {
        return s_read(); // GET /metrics
    }
    return s_unscoped();
}

// The answers of `judge`.
pub fn allowed() -> [] int {
    return 0;
}

// No bearer token, or one that is none of the configured tokens: `401`.
pub fn unauthorized() -> [] int {
    return 1;
}

// A configured token, but of a scope that does not reach this route: `403`.
pub fn forbidden() -> [] int {
    return 2;
}

// A route with no line in the table, and no admin token to fall back on: `403`.
pub fn undeclared() -> [] int {
    return 3;
}

// May this request call route `id`? `tokens` is the three tokens as the delivery state keeps them. A request that matched no route (`id` is
// not positive: a `404` or a `405` is coming) reveals nothing and is let through.
pub fn judge[&q, &t, &k](id: int, request: &q [byte], table: &t [int], tokens: &k [int]) -> [] int {
    if id <= 0 {
        return allowed();
    }
    let scope = scope_of(id);
    if scope == s_open() {
        return allowed();
    }
    // 0 the bearer token is this one, 1 this one is not configured, 2 it is not this one. All three are always compared.
    let admin = manage.authorize(request, table, tokens[0..manage.token_size()]);
    let ingest = manage.authorize(request, table, tokens[ingest_at()..ingest_at() + manage.token_size()]);
    let read = manage.authorize(request, table, tokens[read_at()..read_at() + manage.token_size()]);
    if scope == s_ingest() {
        if ingest == 1 || ingest == 0 || admin == 0 {
            return allowed();
        }
        if read == 0 {
            return forbidden();
        }
        return unauthorized();
    }
    if scope == s_read() {
        if read == 1 || read == 0 || admin == 0 {
            return allowed();
        }
        if ingest == 0 {
            return forbidden();
        }
        return unauthorized();
    }
    // Admin, and a route with no line in the table.
    if admin == 1 {
        if scope == s_unscoped() {
            return undeclared();
        }
        // No admin token: the routes that have always answered `403` ("management is off") still do, in their handlers; the others are open.
        return allowed();
    }
    if admin == 0 {
        return allowed();
    }
    if ingest == 0 || read == 0 {
        return forbidden();
    }
    return unauthorized();
}

// The token a request presented, for the audit log (`audit.cho`): 0 none (no `Authorization`), 1 the admin token, 2 the read token, 3 the ingest token, 4 one that
// is none of them. All three are compared, as `judge` does.
pub fn presented[&q, &t, &k](request: &q [byte], table: &t [int], tokens: &k [int]) -> [] int {
    let admin = manage.authorize(request, table, tokens[0..manage.token_size()]);
    let ingest = manage.authorize(request, table, tokens[ingest_at()..ingest_at() + manage.token_size()]);
    let read = manage.authorize(request, table, tokens[read_at()..read_at() + manage.token_size()]);
    if admin == 0 {
        return 1;
    }
    if read == 0 {
        return 2;
    }
    if ingest == 0 {
        return 3;
    }
    if http.find_header(request, table, "authorization") < 0 {
        return 0;
    }
    return 4;
}

// The scope a refused request needed, in words.
fn needs(scope: int) -> [] &static [byte] {
    if scope == s_ingest() {
        return "this route needs the ingest token (or the admin token)";
    }
    if scope == s_read() {
        return "this route needs the read token (or the admin token)";
    }
    return "this route needs the admin token";
}

// The answer to a request `judge` refused.
pub fn refuse[&h](heap: &!h Heap, out: buffer.Buffer, verdict: int, id: int, keep: bool) -> [heap] buffer.Buffer {
    if verdict == forbidden() {
        return server.failure(heap, out, 403, needs(scope_of(id)), keep);
    }
    if verdict == undeclared() {
        return server.failure(heap, out, 403, "this route has no declared scope and the service was not given an admin-token", keep);
    }
    return server.failure_with(heap, out, 401, "a valid bearer token is required", keep, "WWW-Authenticate: Bearer\r\n");
}
