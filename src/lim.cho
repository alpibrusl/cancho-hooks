edition 5;

module lim;

import epx;
import state;
import std.json;

// `lim` -- what limits how fast a delivery is attempted, and how the retry delays are spread (`docs/design.md` sections 36.3 and 36.4).
//
// Three settings of the service, and two of them can be overridden by each endpoint (`epx.cho` keeps the override, in the endpoint's row):
//
//     retry-jitter          0 to 50 percent         how far each retry delay is moved either way (`jitter.cho`)               default 10
//     endpoint-concurrency  1 to 8                  attempts one endpoint may have in flight together                          default 8
//     endpoint-rate         0 to 100,000 a second   attempts one endpoint may *start* in a second; 0 is no limit               default 0
//
// An endpoint's own `concurrency` and `rate` (the members of `POST` and `PATCH /endpoints`, the columns of the table) replace the service's when
// they are not 0. The concurrency limit was a constant of 8 (`per_endpoint`, section 16) and is the ceiling still: the 64 connections of the
// whole service are shared by every endpoint, and the attempt machinery has no more per-endpoint state than that.
//
// **The rate limit is a token bucket in the loop, on the clock the loop already has.** A bucket holds tokens in thousandths (so a rate of 3 a
// second is exact in integers: elapsed ms x rate thousandths); an attempt costs one whole token; the bucket is `depth(rate)` tokens deep, a tenth of
// a second's worth and at least one, so that the loop's wake-up of at most 50 ms never makes the limit lower than it says, and no second ever sees
// more than `rate + depth(rate)` starts. It starts full. It is memory only: a restart starts every bucket full, which can allow one burst of
// `depth` attempts more than the limit across the restart (the log does not record when an attempt *started*, only how it ended).
//
// **A throttled event is not a failure.** An event that is due and finds its endpoint's bucket empty simply waits: no attempt is made, no record is
// written, the retry counter does not move, and nothing is lost: it is looked at again on the next turn, and `wait_ms` shortens the loop's sleep to
// the time the soonest token needs, so the limit is reached and not undershot. The delivery is as at-least-once as it was: a limit delays a start and
// never drops or repeats one.
//
// The block is one array of integers in the delivery state (`hooks.cho`, `off_lim()`):
//
//     [0] retry-jitter   [1] endpoint-concurrency   [2] endpoint-rate   [3] ms until the soonest token (0 if no endpoint was held back this turn)
//     [8 + 5e ..]  per slot e: state (0 fresh, 1 has a bucket, 2 held back since its last admitted attempt), tokens (thousandths), when it was last
//                  filled (ms, monotonic), times an attempt was held back (since the start), reserved

pub fn stride() -> [] int {
    return 5;
}

pub fn head() -> [] int {
    return 8;
}

pub fn size() -> [] int {
    return head() + state.max_endpoints() * stride();
}

pub fn max_jitter() -> [] int {
    return 50;
}

pub fn default_jitter() -> [] int {
    return 10;
}

pub fn default_concurrency() -> [] int {
    return epx.max_concurrency();
}

// The longest the loop sleeps when nothing is waiting for a token: what it always was.
pub fn idle_wait_ms() -> [] int {
    return 50;
}

pub fn init[&l](l: &!l [int], jitter: int, conc: int, rate: int) -> [] int {
    var i = 0;
    while i < len(l) {
        l[i] = 0;
        i = i + 1;
    }
    l[0] = jitter;
    l[1] = conc;
    l[2] = rate;
    return 0;
}

pub fn jitter_percent[&l](l: &l [int]) -> [] int {
    return l[0];
}

pub fn conc_default[&l](l: &l [int]) -> [] int {
    return l[1];
}

pub fn rate_default[&l](l: &l [int]) -> [] int {
    return l[2];
}

// The concurrency limit in force for the endpoint in row `i` of the table: its own if it has one, else the service's, and never above the ceiling.
pub fn conc_of[&l, &x](l: &l [int], xt: &x [int], i: int) -> [] int {
    var n = epx.conc(xt, i);
    if n <= 0 {
        n = l[1];
    }
    if n > epx.max_concurrency() {
        n = epx.max_concurrency();
    }
    if n < 1 {
        n = 1;
    }
    return n;
}

// The rate limit in force (attempts a second; 0: none).
pub fn rate_of[&l, &x](l: &l [int], xt: &x [int], i: int) -> [] int {
    var n = epx.rate(xt, i);
    if n <= 0 {
        n = l[2];
    }
    return n;
}

// How many tokens a bucket for `rate` holds: a tenth of a second of them, and one at least.
pub fn depth(rate: int) -> [] int {
    var d = (rate + 9) / 10;
    if d < 1 {
        d = 1;
    }
    return d;
}

fn at(e: int) -> [] int {
    return head() + stride() * e;
}

// The loop is about to look at every endpoint once: forget what the last turn found.
pub fn begin_turn[&l](l: &!l [int]) -> [] int {
    l[3] = 0;
    return 0;
}

// May the endpoint in slot `e` start an attempt now (`now` in ms on the monotonic clock) under a limit of `rate` a second? With no limit (0), always,
// and nothing is kept. Otherwise the bucket is filled for the time that has passed (up to its depth), and a whole token is taken if it has one. If it
// has not, the answer is no, the time until it has one is noted for `wait_ms`, and the first refusal after an admitted attempt is counted.
pub fn admit[&l](l: &!l [int], e: int, now: int, rate: int) -> [] bool {
    if rate <= 0 {
        l[at(e)] = 0;
        return true;
    }
    let cap = depth(rate) * 1000;
    if l[at(e)] == 0 {
        l[at(e) + 1] = cap;
        l[at(e) + 2] = now;
        l[at(e)] = 1;
    } else {
        var gone = now - l[at(e) + 2];
        if gone < 0 {
            gone = 0;
        }
        var tokens = l[at(e) + 1] + gone * rate;
        if tokens > cap {
            tokens = cap;
        }
        l[at(e) + 1] = tokens;
        l[at(e) + 2] = now;
    }
    if l[at(e) + 1] >= 1000 {
        l[at(e) + 1] = l[at(e) + 1] - 1000;
        l[at(e)] = 1;
        return true;
    }
    if l[at(e)] != 2 {
        l[at(e) + 3] = l[at(e) + 3] + 1;
    }
    l[at(e)] = 2;
    // the whole milliseconds until a token is whole: (1000 - tokens) thousandths at `rate` thousandths a ms, rounded up
    let need = (1000 - l[at(e) + 1] + rate - 1) / rate;
    var ms = need;
    if ms < 1 {
        ms = 1;
    }
    if l[3] == 0 || ms < l[3] {
        l[3] = ms;
    }
    return false;
}

// How long the loop may sleep: the time until the soonest token of an endpoint that was held back this turn, but never longer than it ever slept.
pub fn wait_ms[&l](l: &l [int]) -> [] int {
    if l[3] > 0 && l[3] < idle_wait_ms() {
        return l[3];
    }
    return idle_wait_ms();
}

// How many times an attempt of the endpoint in slot `e` was held back by its rate limit since the start (a metric: the first refusal after an attempt
// got through counts once, however many turns it waits).
pub fn held_back[&l](l: &l [int], e: int) -> [] int {
    return l[at(e) + 3];
}

// Slot `e` has just been given to an endpoint, or freed: it has no bucket and no count.
pub fn clear_slot[&l](l: &!l [int], e: int) -> [] int {
    var k = 0;
    while k < stride() {
        l[at(e) + k] = 0;
        k = k + 1;
    }
    return 0;
}

// The members `concurrency` and `rate` of an endpoint in `GET /endpoints`: the limits in force (an endpoint that follows the service shows the
// service's), onto `w`.
pub fn put_members[&h, &l, &x](heap: &!h Heap, w: json.Writer, l: &l [int], xt: &x [int], i: int) -> [heap] json.Writer {
    var out = json.put_key(heap, w, "concurrency");
    out = json.put_int(heap, out, conc_of(l, xt, i));
    out = json.put_key(heap, out, "rate");
    out = json.put_int(heap, out, rate_of(l, xt, i));
    return out;
}
