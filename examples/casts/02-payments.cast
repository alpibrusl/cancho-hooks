{"version": 2, "width": 120, "height": 30, "timestamp": 1791381253, "idle_time_limit": 1.5, "title": "Payments that must not be lost or doubled (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.031, "o", "# one endpoint, the shop's server, which is not running yet\r\n$ echo \"0 127.0.0.1 $SHOP_PORT $SECRET\" > $DATA/endpoints.conf\r\n"]
[0.041, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine)\r\n"]
[0.042, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --schedule 500,500,500,500,500,500 --retry-jitter 0 &\r\n"]
[0.11, "o", "# the same payment is sent twice, with the same Idempotency-Key (a client that did not hear the first answer would do this)\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -H 'Idempotency-Key: order-1042' -d '{\"type\":\"payment.captured\",\"order\":1042,\"amount\":4900}'\r\n"]
[0.114, "o", "{\"id\":1} [202]\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -H 'Idempotency-Key: order-1042' -d '{\"type\":\"payment.captured\",\"order\":1042,\"amount\":4900}'\r\n"]
[0.117, "o", "{\"id\":1} [202]\r\n"]
[0.117, "o", "ok: the same id comes back: one event\r\n"]
[0.117, "o", "# the same key for a different payment is refused, not merged\r\n"]
[0.117, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -H 'Idempotency-Key: order-1042' -d '{\"type\":\"payment.captured\",\"order\":1042,\"amount\":9900}'\r\n"]
[0.119, "o", "{\"error\":\"this Idempotency-Key was used for a different event\"} [422]\r\n"]
[0.119, "o", "ok: refused with 422\r\n# the 202 came after the event was flushed to disk. Now the service dies, hard, before it has delivered anything\r\n"]
[0.119, "o", "$ kill -9 $SVC_PID\r\n"]
[0.12, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --schedule 500,500,500,500,500,500 --retry-jitter 0 &\r\n"]
[0.187, "o", "# the key was remembered too: asking again does not make a second event\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -H 'Idempotency-Key: order-1042' -d '{\"type\":\"payment.captured\",\"order\":1042,\"amount\":4900}'\r\n"]
[0.19, "o", "{\"id\":1} [202]\r\n"]
[0.19, "o", "ok: still the same id\r\n# the shop's server comes back\r\n"]
[0.191, "o", "$ python3 examples/receiver.py --name shop --port $SHOP_PORT --secret-file shop.secret &\r\n"]
[0.67, "o", "  shop evt_1 signature ok (1 signature) {\"type\":\"payment.captured\",\"order\":1042,\"amount\":4900}\r\n"]
[2.17, "o", "ok: it arrived, once, although the service was killed and the shop was down\r\n# a repeat of a delivery has the same webhook-id (evt_1): the receiver drops it. Here the service is asked to send the event again\r\n"]
[2.17, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events/1/replay -H \"Authorization: Bearer $ADMIN\"\r\n"]
[2.182, "o", "{\"event\":1,\"endpoints\":[0]} [202]\r\n"]
[2.197, "o", "  shop evt_1 signature ok (1 signature) duplicate\r\n"]
[2.198, "o", "ok: the second delivery is the same webhook-id and the receiver said duplicate\r\n"]
