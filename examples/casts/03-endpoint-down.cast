{"version": 2, "width": 120, "height": 30, "timestamp": 1791381254, "idle_time_limit": 1.5, "title": "A customer's endpoint is down (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.03, "o", "# one endpoint, and nothing is listening on its port\r\n$ echo \"0 127.0.0.1 $CUSTOMER_PORT $SECRET\" > $DATA/endpoints.conf\r\n"]
[0.04, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine)\r\n"]
[0.04, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --schedule 200,300,400 --retry-jitter 0 &\r\n"]
[0.107, "o", "# three events are accepted (202) all the same\r\n$ for i in 1 2 3; do curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d \"{\\\"type\\\":\\\"order.shipped\\\",\\\"order\\\":$i}\"; done\r\n"]
[0.117, "o", "{\"id\":1} [202]\r\n{\"id\":2} [202]\r\n{\"id\":3} [202]\r\n"]
[0.118, "o", "ok: three accepted\r\n"]
[0.118, "o", "# each is tried, retried and, when the schedule is spent, a dead letter of this endpoint\r\n"]
[1.108, "o", "$ curl -s \"$URL/endpoints/0/dead?limit=2\"\r\n"]
[1.11, "o", "{\"endpoint\":0,\"order\":\"desc\",\"held\":3,\"truncated\":false,\"complete_above\":0,\"dead\":[{\"event\":3,\"type\":\"order.shipped\",\"attempts\":4,\"reason\":\"connect_refused\",\"died_at\":1791381254790,\"replaying\":false},{\"event\":2,\"type\":\"order.shipped\",\"attempts\":4,\"reason\":\"connect_refused\",\"died_at\":1791381254790,\"replaying\":false}],\"next\":2}\r\n"]
[1.119, "o", "ok: three dead letters held, every one tried four times and refused by the connection\r\n"]
[1.119, "o", "# the customer is back\r\n"]
[1.12, "o", "$ python3 examples/receiver.py --name customer --port $CUSTOMER_PORT --secret-file customer.secret &\r\n"]
[1.183, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/endpoints/0/replay-dead -H \"Authorization: Bearer $ADMIN\"\r\n"]
[1.187, "o", "{\"endpoint\":0,\"taken\":3,\"remaining\":0,\"waiting\":3,\"next\":3} [202]\r\n"]
[1.195, "o", "  customer evt_1 signature ok (1 signature) {\"type\":\"order.shipped\",\"order\":1}\r\n  customer evt_2 signature ok (1 signature) {\"type\":\"order.shipped\",\"order\":2}\r\n  customer evt_3 signature ok (1 signature) {\"type\":\"order.shipped\",\"order\":3}\r\n"]
[1.195, "o", "ok: all three arrived, signed, once each\r\n$ curl -s \"$URL/endpoints/0/dead\"\r\n"]
[1.198, "o", "{\"endpoint\":0,\"order\":\"desc\",\"held\":0,\"truncated\":false,\"complete_above\":0,\"dead\":[],\"next\":null}\r\n"]
[1.207, "o", "ok: no dead letters are left\r\n"]
