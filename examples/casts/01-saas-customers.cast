{"version": 2, "width": 120, "height": 30, "timestamp": 1791381249, "idle_time_limit": 1.5, "title": "A SaaS sends its customers webhooks (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.144, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine), pg-* = a PostgreSQL\r\n"]
[0.144, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA &\r\n"]
[0.222, "o", "# two customers: acme wants invoices, at most 2 requests at once and 10 a second; globex wants everything\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/endpoints -H \"Authorization: Bearer $ADMIN\" -d '{\"host\":\"127.0.0.1\",\"port\":'$ACME_PORT',\"types\":[\"invoice.*\"],\"headers\":{\"X-Customer\":\"acme\"},\"concurrency\":2,\"rate\":10}'\r\n"]
[0.226, "o", "{\"id\":0,\"host\":\"127.0.0.1\",\"scheme\":\"http\",\"port\":33319,\"secret\":\"whsec_…\",\"from\":\"now\",\"cursor\":0} [201]\r\n"]
[0.244, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/endpoints -H \"Authorization: Bearer $ADMIN\" -d '{\"host\":\"127.0.0.1\",\"port\":'$GLOBEX_PORT',\"headers\":{\"X-Customer\":\"globex\"}}'\r\n"]
[0.248, "o", "{\"id\":1,\"host\":\"127.0.0.1\",\"scheme\":\"http\",\"port\":59861,\"secret\":\"whsec_…\",\"from\":\"now\",\"cursor\":0} [201]\r\n"]
[0.257, "o", "# each secret is in the answer that made the endpoint and in no other; it goes to the customer, who keeps it\r\n"]
[0.257, "o", "$ curl -s $URL/endpoints -H \"Authorization: Bearer $ADMIN\"\r\n"]
[0.26, "o", "[{\"id\":0,\"port\":33319,\"scheme\":\"http\",\"cursor\":0,\"disabled\":false,\"paused\":false,\"failing_since\":0,\"types\":[\"invoice.*\"],\"headers\":[\"X-Customer\"],\"secret_old_until\":0,\"concurrency\":2,\"rate\":10},{\"id\":1,\"port\":59861,\"scheme\":\"http\",\"cursor\":0,\"disabled\":false,\"paused\":false,\"failing_since\":0,\"types\":[],\"headers\":[\"X-Customer\"],\"secret_old_until\":0,\"concurrency\":8,\"rate\":0}]\r\n"]
[0.269, "o", "ok: the list shows each endpoint's filter, header names and limits, and no secret\r\n"]
[0.272, "o", "$ python3 examples/receiver.py --name acme --port $ACME_PORT --secret-file acme.secret --show-header X-Customer &\r\n"]
[0.337, "o", "$ python3 examples/receiver.py --name globex --port $GLOBEX_PORT --secret-file globex.secret --show-header X-Customer &\r\n"]
[0.4, "o", "# an invoice goes to both; a new user goes to globex only\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"invoice.paid\",\"invoice\":\"INV-1001\",\"amount\":4900}'\r\n"]
[0.404, "o", "{\"id\":1} [202]\r\n"]
[0.404, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"user.created\",\"user\":\"u_77\"}'\r\n"]
[0.408, "o", "{\"id\":2} [202]\r\n# what the receivers print (each verified the signature with the secret it was given)\r\n"]
[0.415, "o", "  acme evt_1 signature ok (1 signature) {\"type\":\"invoice.paid\",\"invoice\":\"INV-1001\",\"amount\":4900} X-Customer=acme\r\n"]
[0.422, "o", "  globex evt_1 signature ok (1 signature) {\"type\":\"invoice.paid\",\"invoice\":\"INV-1001\",\"amount\":4900} X-Customer=globex\r\n  globex evt_2 signature ok (1 signature) {\"type\":\"user.created\",\"user\":\"u_77\"} X-Customer=globex\r\n"]
[0.424, "o", "ok: acme got the invoice only, globex got both\r\n"]
[0.426, "o", "ok: every delivery verified, and carried its customer's own header\r\n"]
[0.426, "o", "$ curl -s $URL/stats -H \"Authorization: Bearer $ADMIN\" | grep -oE '\"(delivered|failed|filtered)\":[0-9]+'\r\n"]
[0.429, "o", "\"delivered\":3\r\n\"failed\":0\r\n\"filtered\":1\r\n"]
[0.43, "o", "ok: the service counted one event it did not send to acme, and no failure\r\n"]
[0.43, "o", "# acme rotates its secret: deliveries are signed with the new one and, for a day (keep_old), with the old one too\r\n"]
[0.43, "o", "$ curl -s -w ' [%{http_code}]\\n' -X PATCH $URL/endpoints/$ACME_ID -H \"Authorization: Bearer $ADMIN\" -d '{\"rotate\":true,\"keep_old\":true}'\r\n"]
[0.433, "o", "{\"id\":0,\"host\":\"127.0.0.1\",\"scheme\":\"http\",\"port\":33319,\"secret\":\"whsec_…\",\"secret_old_until\":1791467649685} [200]\r\n"]
[0.442, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"invoice.paid\",\"invoice\":\"INV-1002\",\"amount\":1500}'\r\n"]
[0.445, "o", "{\"id\":3} [202]\r\n"]
[0.445, "o", "# acme's receiver still knows only the old secret, and verifies it: the delivery carries two signatures\r\n"]
[0.509, "o", "  acme evt_3 signature ok (2 signatures) {\"type\":\"invoice.paid\",\"invoice\":\"INV-1002\",\"amount\":1500} X-Customer=acme\r\n"]
[0.51, "o", "# acme switches its receiver to the new secret, at its own time\r\n$ echo \"$ACME_NEW\" > acme.secret\r\n"]
[0.513, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"invoice.paid\",\"invoice\":\"INV-1003\",\"amount\":700}'\r\n"]
[0.519, "o", "{\"id\":4} [202]\r\n"]
[0.642, "o", "  acme evt_4 signature ok (2 signatures) {\"type\":\"invoice.paid\",\"invoice\":\"INV-1003\",\"amount\":700} X-Customer=acme\r\n"]
[0.643, "o", "# when acme is ready it ends the overlap, and only the new signature is sent\r\n$ curl -s -w ' [%{http_code}]\\n' -X PATCH $URL/endpoints/$ACME_ID -H \"Authorization: Bearer $ADMIN\" -d '{\"keep_old_ms\":0}'\r\n"]
[0.647, "o", "{\"id\":0,\"host\":\"127.0.0.1\",\"scheme\":\"http\",\"port\":33319} [200]\r\n"]
[0.647, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"invoice.paid\",\"invoice\":\"INV-1004\",\"amount\":300}'\r\n"]
[0.651, "o", "{\"id\":5} [202]\r\n"]
[0.716, "o", "  acme evt_5 signature ok (1 signature) {\"type\":\"invoice.paid\",\"invoice\":\"INV-1004\",\"amount\":300} X-Customer=acme\r\n"]
[0.724, "o", "ok: the three deliveries after the rotation began carried two signatures, two, then one, and every one verified\r\n$ curl -s $URL/stats -H \"Authorization: Bearer $ADMIN\" | grep -oE '\"(delivered|failed)\":[0-9]+'\r\n"]
[0.728, "o", "\"delivered\":9\r\n\"failed\":0\r\n"]
[0.728, "o", "ok: no delivery failed, rotation included\r\n"]
