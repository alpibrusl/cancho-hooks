{"version": 2, "width": 120, "height": 30, "timestamp": 1791381267, "idle_time_limit": 1.5, "title": "One event, several internal systems (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.069, "o", "# three endpoints: billing wants invoices, audit wants everything, search wants invoices and users and takes one request at a time\r\n$ cat > $DATA/endpoints.conf <<EOF\r\n0 127.0.0.1 $BILLING_PORT $(cat billing.secret) types=invoice.*\r\n1 127.0.0.1 $AUDIT_PORT $(cat audit.secret)\r\n2 127.0.0.1 $SEARCH_PORT $(cat search.secret) types=invoice.*,user.* concurrency=1\r\nEOF\r\n"]
[0.081, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine)\r\n"]
[0.081, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA &\r\n"]
[0.152, "o", "$ python3 examples/receiver.py --name billing --port $BILLING_PORT --secret-file billing.secret &\r\n"]
[0.218, "o", "$ python3 examples/receiver.py --name audit --port $AUDIT_PORT --secret-file audit.secret &\r\n"]
[0.283, "o", "$ python3 examples/receiver.py --name search --port $SEARCH_PORT --secret-file search.secret --delay 1.5 &\r\n"]
[0.349, "o", "# four events, one after the other\r\n"]
[0.355, "o", "$ for t in invoice.paid user.created invoice.refunded invoice.paid; do curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d \"{\\\"type\\\":\\\"$t\\\"}\"; done\r\n"]
[0.371, "o", "{\"id\":1} [202]\r\n{\"id\":2} [202]\r\n{\"id\":3} [202]\r\n{\"id\":4} [202]\r\n"]
[1.871, "o", "# what each receiver got, and when it had it all (from the first event posted)\r\n"]
[1.873, "o", "billing: 3 deliveries (invoice.*), done after 30 ms\r\n"]
[1.874, "o", "audit:   4 deliveries (everything), done after 42 ms\r\n"]
[1.875, "o", "search:  4 deliveries (invoice.*, user.*; 1.5 s each, one at a time), done after 6077 ms\r\n"]
[1.876, "o", "ok: billing got the 3 invoice events, audit all 4, search all 4\r\n"]
[1.877, "o", "ok: every delivery verified\r\n"]
[1.877, "o", "ok: the two fast receivers were done in less than half the time the slow one needed\r\nok: the slow one took at least 4 x 1.5 s: it was held to one request at a time\r\n"]
