{"version": 2, "width": 120, "height": 30, "timestamp": 1791381276, "idle_time_limit": 1.5, "title": "Let an agent look (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.014, "o", "# a service with one endpoint nobody listens to, and one event that cannot be delivered\r\n"]
[0.044, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine)\r\n"]
[0.044, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --schedule 100 --retry-jitter 0 &\r\n"]
[0.111, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"order.shipped\",\"order\":7}'\r\n"]
[0.115, "o", "{\"id\":1} [202]\r\n"]
[0.247, "o", "# the agent's client says hello, lists the tools, then asks about the event, the dead letters and tries to post an event\r\n"]
[0.248, "o", "$ hooks-mcp --url $URL < requests.jsonl > replies.jsonl; echo \"$(wc -l < replies.jsonl) replies\"\r\n"]
[0.255, "o", "5 replies\r\n# the tools it was offered (read-only: nothing here changes anything)\r\n"]
[0.255, "o", "$ grep '\"id\":2,' replies.jsonl | grep -o '\"name\":\"hooks_[a-z_]*\"'\r\n"]
[0.257, "o", "\"name\":\"hooks_health\"\r\n\"name\":\"hooks_stats\"\r\n\"name\":\"hooks_get_event\"\r\n\"name\":\"hooks_list_endpoints\"\r\n\"name\":\"hooks_list_dead_letters\"\r\n\"name\":\"hooks_get_attempts\"\r\n"]
[0.261, "o", "ok: six tools, and no hooks_post_event among them\r\n# what it was told about the event and the dead letters, and the refusal of the write\r\n$ grep -E '\"id\":[345],' replies.jsonl\r\n"]
[0.262, "o", "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"id\\\":1,\\\"event\\\":{\\\"type\\\":\\\"order.shipped\\\",\\\"order\\\":7}}\"}],\"isError\":false}}\r\n{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"endpoint\\\":0,\\\"order\\\":\\\"desc\\\",\\\"held\\\":1,\\\"truncated\\\":false,\\\"complete_above\\\":0,\\\"dead\\\":[{\\\"event\\\":1,\\\"type\\\":\\\"order.shipped\\\",\\\"attempts\\\":2,\\\"reason\\\":\\\"connect_refused\\\",\\\"died_at\\\":1791381276882,\\\"replaying\\\":false}],\\\"next\\\":null}\"}],\"isError\":false}}\r\n{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32602,\"message\":\"Invalid params: unknown tool\"}}\r\n"]
[0.267, "o", "ok: the event, the dead letter, and an unknown-tool error for the post\r\n"]
[0.267, "o", "$ curl -s -w ' [%{http_code}]\\n' $URL/events/2\r\n"]
[0.272, "o", "{\"error\":\"no such event\"} [404]\r\n"]
[0.272, "o", "ok: and no event 2 was made\r\n"]
