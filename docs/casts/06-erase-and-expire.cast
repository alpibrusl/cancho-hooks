{"version": 2, "width": 120, "height": 30, "timestamp": 1791381276, "idle_time_limit": 1.5, "title": "Erase and expire personal data (recorded from a real run; waits longer than 1.5 s are shortened to 1.5 s)", "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.034, "o", "# part one. One endpoint that is down for now; two events wait for it, one of them about a person\r\n$ echo \"0 127.0.0.1 $CUSTOMER_PORT $(cat customer.secret)\" > $DATA/endpoints.conf\r\n"]
[0.046, "o", "# hooks.conf: admin-token = <secret>, allow-private-hosts = 1 (the receivers are on this machine)\r\n"]
[0.046, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --schedule 4000,4000,4000 --retry-jitter 0 &\r\n"]
[0.119, "o", "$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"customer.updated\",\"email\":\"ana@example.com\"}'\r\n"]
[0.123, "o", "{\"id\":1} [202]\r\n$ curl -s -w ' [%{http_code}]\\n' -X POST $URL/events -d '{\"type\":\"order.created\",\"email\":\"ben@example.com\"}'\r\n"]
[0.127, "o", "{\"id\":2} [202]\r\n$ curl -s -w ' [%{http_code}]\\n' $URL/events/1\r\n"]
[0.13, "o", "{\"id\":1,\"event\":{\"type\":\"customer.updated\",\"email\":\"ana@example.com\"}} [200]\r\n$ grep -rl ana@example.com $DATA | sed \"s|^$DATA/||\"\r\n"]
[0.131, "o", "events.seg\r\nok: the address is in a file of the data directory\r\n# erasure\r\n"]
[0.131, "o", "$ curl -s -w ' [%{http_code}]\\n' -X DELETE $URL/events/1 -H \"Authorization: Bearer $ADMIN\"\r\n"]
[0.136, "o", "{\"id\":1,\"erased\":true} [200]\r\n"]
[0.136, "o", "ok: erased\r\n"]
[0.136, "o", "$ curl -s -w ' [%{http_code}]\\n' $URL/events/1\r\n"]
[0.139, "o", "{\"error\":\"the event was erased (DELETE /events/:id)\"} [410]\r\n"]
[0.139, "o", "ok: it is gone: 410\r\n$ (grep -rl ana@example.com $DATA || echo 'ana@example.com: in no file') | sed \"s|^$DATA/||\"\r\n"]
[0.14, "o", "ana@example.com: in no file\r\n"]
[0.14, "o", "ok: the address is in no file of the data directory\r\n$ grep -rl ben@example.com $DATA | sed \"s|^$DATA/||\"\r\n"]
[0.141, "o", "events.seg\r\n"]
[0.141, "o", "ok: the other event is untouched\r\n# what is not erased: the event's type (and its id, its size and its idempotency key if it had one)\r\n$ grep -rao customer.updated $DATA | sed \"s|^$DATA/||\"\r\n"]
[0.142, "o", "events.seg:customer.updated\r\n"]
[0.142, "o", "ok: the type of the erased event is still in the log\r\n# the customer's server comes back: it gets the event that is left, and never the erased one\r\n"]
[0.143, "o", "$ python3 examples/receiver.py --name customer --port $CUSTOMER_PORT --secret-file customer.secret &\r\n"]
[1.643, "o", "  customer evt_2 signature ok (1 signature) {\"type\":\"order.created\",\"email\":\"ben@example.com\"}\r\n"]
[2.649, "o", "ok: only the event that was not erased arrived\r\n"]
[2.653, "o", "# part two. Events that nothing may keep: an endpoint that is down pins them (retention only drops what is final everywhere)\r\n"]
[2.655, "o", "$ echo \"0 127.0.0.1 $CUSTOMER_PORT $(cat customer.secret)\" > $DATA/endpoints.conf\r\n"]
[2.659, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --segment-bytes 262144 --schedule 3600000 &\r\n"]
[2.741, "o", "# six events of 60 KB: more than a 256 KiB segment, so the first segment is sealed\r\n$ printf '{\"type\":\"export.ready\",\"pad\":\"%s\"}' \"$(head -c 60000 /dev/zero | tr '\\0' x)\" > big.json\r\n"]
[2.748, "o", "$ for i in 1 2 3 4 5 6; do curl -s -w ' [%{http_code}]\\n' -X POST $URL/events --data-binary @big.json; done\r\n"]
[2.796, "o", "{\"id\":1} [202]\r\n{\"id\":2} [202]\r\n{\"id\":3} [202]\r\n{\"id\":4} [202]\r\n{\"id\":5} [202]\r\n{\"id\":6} [202]\r\n"]
[4.296, "o", "$ curl -s -o /dev/null -w '%{http_code}\\n' $URL/events/1\r\n"]
[4.305, "o", "200\r\n"]
[4.305, "o", "ok: no maximum age: event 1 is still there, held by the endpoint that is down\r\n"]
[4.308, "o", "# the same data, with a maximum age of 3 seconds (the real setting is --max-age-days; this is its knob for tests)\r\n"]
[4.309, "o", "$ hooks --config hooks.conf --port $PORT --dir $DATA --segment-bytes 262144 --schedule 3600000 --max-age-ms 3000 &\r\n"]
[4.403, "o", "$ curl -s -o /dev/null -w '%{http_code}\\n' $URL/events/1\r\n"]
[4.406, "o", "410\r\n"]
[4.406, "o", "$ curl -s $URL/stats | grep -oE '\"(events_expired|segments_expired)\":[0-9]+'\r\n"]
[4.41, "o", "\"events_expired\":5\r\n\"segments_expired\":1\r\n"]
[4.41, "o", "ok: the expired events are counted, not hidden\r\n"]
