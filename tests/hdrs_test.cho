edition 5;

import std.test;
import hdrs;

// The custom headers of an endpoint (`src/hdrs.cho`, docs/design.md section 35): which names and values are allowed, the spec they are kept in, and the
// wire form it decodes to.

fn test_good_names() -> [] int {
    test.assert_eq(hdrs.check_name("Authorization"), 0);
    test.assert_eq(hdrs.check_name("X-Api-Key"), 0);
    test.assert_eq(hdrs.check_name("x_y.z~1"), 0);
    test.assert_eq(hdrs.check_name("A"), 0);
    return 0;
}

fn test_bad_names() -> [] int {
    test.assert_eq(hdrs.check_name(""), hdrs.bad_name());
    test.assert_eq(hdrs.check_name("a b"), hdrs.bad_name());
    test.assert_eq(hdrs.check_name("a:b"), hdrs.bad_name());
    test.assert_eq(hdrs.check_name("a,b"), hdrs.bad_name());
    test.assert_eq(hdrs.check_name("a\r\nb"), hdrs.bad_name());
    test.assert_eq(hdrs.check_name("café"), hdrs.bad_name());
    region a {
        let n = alloc_slice[a](70, byte_of('x'));
        test.assert_eq(hdrs.check_name(n[0..64]), 0);
        test.assert_eq(hdrs.check_name(n[0..65]), hdrs.bad_name());
    }
    return 0;
}

fn test_the_headers_the_delivery_sets_and_the_connection_ones_are_forbidden_in_any_case() -> [] int {
    test.assert_eq(hdrs.check_name("webhook-id"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Webhook-Id"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("WEBHOOK-TIMESTAMP"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("webhook-signature"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Host"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Content-Length"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("content-TYPE"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Connection"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Transfer-Encoding"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Keep-Alive"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Proxy-Connection"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Proxy-Authenticate"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Proxy-Authorization"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("TE"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Trailer"), hdrs.forbidden_name());
    test.assert_eq(hdrs.check_name("Upgrade"), hdrs.forbidden_name());
    // near misses are fine
    test.assert_eq(hdrs.check_name("webhook-ids"), 0);
    test.assert_eq(hdrs.check_name("x-host"), 0);
    test.assert_eq(hdrs.check_name("Authorization"), 0);
    test.assert_eq(hdrs.check_name("Content-Encoding2"), 0);
    return 0;
}

fn test_values() -> [] int {
    test.assert_eq(hdrs.check_value("Bearer abc.def-123"), 0);
    test.assert_eq(hdrs.check_value("x"), 0);
    test.assert_eq(hdrs.check_value("two  spaces inside"), 0);
    test.assert_eq(hdrs.check_value(""), hdrs.bad_length());
    test.assert_eq(hdrs.check_value(" x"), hdrs.edge_space());
    test.assert_eq(hdrs.check_value("x "), hdrs.edge_space());
    test.assert_eq(hdrs.check_value("a\r\nX: y"), hdrs.bad_byte());
    test.assert_eq(hdrs.check_value("a\nb"), hdrs.bad_byte());
    test.assert_eq(hdrs.check_value("a\rb"), hdrs.bad_byte());
    test.assert_eq(hdrs.check_value("a\tb"), hdrs.bad_byte());
    test.assert_eq(hdrs.check_value("café"), hdrs.bad_byte());
    region a {
        let v = alloc_slice[a](600, byte_of('v'));
        test.assert_eq(hdrs.check_value(v[0..512]), 0);
        test.assert_eq(hdrs.check_value(v[0..513]), hdrs.bad_length());
        v[3] = byte_of(0);
        test.assert_eq(hdrs.check_value(v[0..10]), hdrs.bad_byte());
        v[3] = byte_of(127);
        test.assert_eq(hdrs.check_value(v[0..10]), hdrs.bad_byte());
        // every control character is refused, not only CR, LF and NUL
        var c = 1;
        while c < 32 {
            v[3] = byte_of(c);
            test.assert_eq(hdrs.check_value(v[0..10]), hdrs.bad_byte());
            c = c + 1;
        }
    }
    return 0;
}

fn test_a_value_is_percent_encoded_but_for_the_unreserved_bytes() -> [] int {
    region a {
        let out = alloc_slice[a](64, byte_of(0));
        let n = hdrs.encode_value("Bearer abc", out, 0, 64);
        test.assert_eq(n, 12);
        test.assert_eq(int_of(out[6]), int_of(byte_of('%')));
        test.assert_eq(int_of(out[7]), int_of(byte_of('2')));
        test.assert_eq(int_of(out[8]), int_of(byte_of('0')));
        let m = hdrs.encode_value("a,b%c-._~", out, 0, 64);
        // a %2C b %25 c - . _ ~
        test.assert_eq(m, 1 + 3 + 1 + 3 + 1 + 4);
        // it does not pass its limit
        test.assert_eq(hdrs.encode_value("a b", out, 0, 4), 0 - 1);
        test.assert_eq(hdrs.encode_value("a b", out, 0, 5), 5);
    }
    return 0;
}

fn spec_code(spec: &static [byte]) -> [] int {
    return hdrs.check_spec(spec);
}

fn test_good_specs() -> [] int {
    test.assert_eq(spec_code(""), 0);
    test.assert_eq(spec_code("A:b"), 0);
    test.assert_eq(spec_code("Authorization:Bearer%20abc,X-Key:k"), 0);
    test.assert_eq(spec_code("A:b%2Cc,B:%25"), 0);
    // raw visible bytes other than , and % are read as they are
    test.assert_eq(spec_code("A:a+b/c=d:e"), 0);
    test.assert_eq(hdrs.count_of("A:b,C:d,E:f"), 3);
    test.assert_eq(hdrs.count_of(""), 0);
    return 0;
}

fn test_bad_specs_each_with_its_reason() -> [] int {
    test.assert_eq(spec_code("A"), hdrs.malformed());
    test.assert_eq(spec_code("A:b,"), hdrs.malformed());
    test.assert_eq(spec_code(",A:b"), hdrs.malformed());
    test.assert_eq(spec_code("A:b,,C:d"), hdrs.malformed());
    test.assert_eq(spec_code("A:"), hdrs.bad_length());
    test.assert_eq(spec_code(":v"), hdrs.bad_name());
    test.assert_eq(spec_code("A:b,a:c"), hdrs.repeated_name());
    test.assert_eq(spec_code("A:b,C:d,A:e"), hdrs.repeated_name());
    test.assert_eq(spec_code("Host:x"), hdrs.forbidden_name());
    test.assert_eq(spec_code("ok:1,webhook-signature:x"), hdrs.forbidden_name());
    // CR, LF and NUL by percent-encoding are refused as a CR, an LF and a NUL are
    test.assert_eq(spec_code("A:x%0d%0aInjected:1"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%0D%0AInjected:1"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%0a"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:%00"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:%7f"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%01"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%08"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%09"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:x%1f"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:%80"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:%zz"), hdrs.malformed());
    test.assert_eq(spec_code("A:%2"), hdrs.malformed());
    test.assert_eq(spec_code("A:x%"), hdrs.malformed());
    test.assert_eq(spec_code("A:%20x"), hdrs.edge_space());
    test.assert_eq(spec_code("A:x%20"), hdrs.edge_space());
    // a raw byte outside visible ASCII
    test.assert_eq(spec_code("A:x y"), hdrs.bad_byte());
    test.assert_eq(spec_code("A:café"), hdrs.bad_byte());
    return 0;
}

fn test_eight_headers_not_nine() -> [] int {
    test.assert_eq(spec_code("a:1,b:1,c:1,d:1,e:1,f:1,g:1,h:1"), 0);
    test.assert_eq(spec_code("a:1,b:1,c:1,d:1,e:1,f:1,g:1,h:1,i:1"), hdrs.too_many());
    return 0;
}

fn test_one_value_of_512_bytes_is_fine_and_513_is_not() -> [] int {
    region a {
        let s = alloc_slice[a](700, byte_of('v'));
        s[0] = byte_of('A');
        s[1] = byte_of(':');
        test.assert_eq(hdrs.check_spec(s[0..2 + 512]), 0);
        test.assert_eq(hdrs.check_spec(s[0..2 + 513]), hdrs.bad_length());
    }
    return 0;
}

// Eight headers of one-letter names and values of `n` bytes each, as a spec in `t`; answers its length.
fn eight[&t](t: &!t [byte], n: int) -> [] int {
    var at = 0;
    var h = 0;
    while h < 8 {
        if h > 0 {
            t[at] = byte_of(',');
            at = at + 1;
        }
        t[at] = byte_of('a' + h);
        t[at + 1] = byte_of(':');
        var k = 0;
        while k < n {
            t[at + 2 + k] = byte_of('v');
            k = k + 1;
        }
        at = at + 2 + n;
        h = h + 1;
    }
    return at;
}

fn test_the_wire_form_is_at_most_2048_bytes() -> [] int {
    region a {
        let t = alloc_slice[a](5000, byte_of('v'));
        // each is 1 + 4 + n on the wire: 252 makes 8 * 257 = 2,056
        test.assert_eq(hdrs.check_spec(t[0..eight(t, 252)]), hdrs.too_large());
        // 251 makes 8 * 256 = 2,048 exactly: allowed
        test.assert_eq(hdrs.check_spec(t[0..eight(t, 251)]), 0);
        test.assert_eq(hdrs.decode(t[0..eight(t, 251)], alloc_slice[a](2048, 0)), 2048);
    }
    return 0;
}

fn test_a_spec_is_at_most_4096_bytes() -> [] int {
    region a {
        let t = alloc_slice[a](5000, byte_of('v'));
        t[0] = byte_of('a');
        t[1] = byte_of(':');
        test.assert_eq(hdrs.check_spec(t[0..4097]), hdrs.too_large());
    }
    return 0;
}

fn test_the_wire_form() -> [] int {
    region a {
        let out = alloc_slice[a](2048, 0);
        let n = hdrs.decode("Authorization:Bearer%20abc,X-Key:k%2Cz", out);
        // "Authorization: Bearer abc\r\nX-Key: k,z\r\n"
        test.assert_eq(n, 13 + 2 + 10 + 2 + 5 + 2 + 3 + 2);
        test.assert_eq(out[0], int_of(byte_of('A')));
        test.assert_eq(out[13], int_of(byte_of(':')));
        test.assert_eq(out[14], int_of(byte_of(' ')));
        test.assert_eq(out[15], int_of(byte_of('B')));
        test.assert_eq(out[21], int_of(byte_of(' ')));
        test.assert_eq(out[24], int_of(byte_of('c')));
        test.assert_eq(out[25], int_of(byte_of('\r')));
        test.assert_eq(out[26], int_of(byte_of('\n')));
        test.assert_eq(out[27], int_of(byte_of('X')));
        test.assert_eq(out[n - 2], int_of(byte_of('\r')));
        test.assert_eq(out[n - 1], int_of(byte_of('\n')));
        test.assert_eq(out[n - 3], int_of(byte_of('z')));
        test.assert_eq(out[n - 4], int_of(byte_of(',')));
        // a spec that is not good decodes to nothing
        test.assert_eq(hdrs.decode("A:%0d%0a", out), 0 - 1);
        test.assert_eq(hdrs.decode("", out), 0);
    }
    return 0;
}
