edition 5;

import std.test;
import lim;
import epx;

// What limits the pace of an endpoint's attempts (`src/lim.cho`, `docs/design.md` section 39.4): the limits in force, and the token bucket.

// Room for eight slots: a test that holds a row of extras beside the limits has to fit the 64 KiB of a region (`lim.size()` is 41 KB for the 1,024 slots there are).
fn small() -> [] int {
    return lim.head() + 8 * lim.stride();
}

fn test_an_endpoint_follows_the_service_unless_it_has_limits_of_its_own() -> [] int {
    region a {
        let l = alloc_slice[a](small(), 0);
        let xt = alloc_slice[a](2 * epx.stride(), 0);
        lim.init(l, 10, 6, 40);
        test.assert_eq(lim.conc_of(l, xt, 0), 6);
        test.assert_eq(lim.rate_of(l, xt, 0), 40);
        epx.set_conc(xt, 1, 2);
        epx.set_rate(xt, 1, 5);
        test.assert_eq(lim.conc_of(l, xt, 1), 2);
        test.assert_eq(lim.rate_of(l, xt, 1), 5);
        // the first row is untouched, and so is the service
        test.assert_eq(lim.conc_of(l, xt, 0), 6);
        test.assert_eq(lim.rate_of(l, xt, 0), 40);
        // an endpoint's own limit of 0 follows the service again
        epx.set_conc(xt, 1, 0);
        epx.set_rate(xt, 1, 0);
        test.assert_eq(lim.conc_of(l, xt, 1), 6);
        test.assert_eq(lim.rate_of(l, xt, 1), 40);
        test.assert_eq(lim.jitter_percent(l), 10);
    }
    return 0;
}

fn test_the_concurrency_never_exceeds_the_ceiling_or_falls_below_one() -> [] int {
    region a {
        let l = alloc_slice[a](small(), 0);
        let xt = alloc_slice[a](epx.stride(), 0);
        lim.init(l, 0, 0, 0);
        test.assert_eq(lim.conc_of(l, xt, 0), 1);
        epx.set_conc(xt, 0, 99);
        test.assert_eq(lim.conc_of(l, xt, 0), 8);
        lim.init(l, 0, 99, 0);
        epx.set_conc(xt, 0, 0);
        test.assert_eq(lim.conc_of(l, xt, 0), 8);
    }
    return 0;
}

fn test_a_bucket_is_a_tenth_of_a_second_deep_and_at_least_one_token() -> [] int {
    test.assert_eq(lim.depth(1), 1);
    test.assert_eq(lim.depth(5), 1);
    test.assert_eq(lim.depth(10), 1);
    test.assert_eq(lim.depth(11), 2);
    test.assert_eq(lim.depth(100), 10);
    test.assert_eq(lim.depth(100000), 10000);
    return 0;
}

fn test_no_limit_always_admits_and_keeps_nothing() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 0);
        var t = 0;
        while t < 100 {
            test.assert(lim.admit(l, 3, 1000, 0));
            t = t + 1;
        }
        test.assert_eq(lim.held_back(l, 3), 0);
        test.assert_eq(lim.wait_ms(l), 50);
    }
    return 0;
}

// Rate 10 a second: a bucket of one token. The first attempt goes at once; the next waits 100 ms.
fn test_a_bucket_starts_full_and_refills_at_the_rate() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 10);
        lim.begin_turn(l);
        test.assert(lim.admit(l, 0, 5000, 10));
        test.assert(!lim.admit(l, 0, 5000, 10));
        // 100 ms is needed for the next token
        test.assert_eq(lim.wait_ms(l), 50);
        test.assert(!lim.admit(l, 0, 5050, 10));
        test.assert(!lim.admit(l, 0, 5099, 10));
        test.assert(lim.admit(l, 0, 5100, 10));
        test.assert(!lim.admit(l, 0, 5100, 10));
        test.assert(!lim.admit(l, 0, 5150, 10));
        test.assert(lim.admit(l, 0, 5200, 10));
    }
    return 0;
}

// The bucket does not store more than its depth however long it was idle.
fn test_idle_time_buys_one_burst_and_no_more() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 20);
        // depth 2
        test.assert(lim.admit(l, 0, 1000, 20));
        test.assert(lim.admit(l, 0, 1000, 20));
        test.assert(!lim.admit(l, 0, 1000, 20));
        // an hour later: two tokens, not 72,000
        test.assert(lim.admit(l, 0, 3601000, 20));
        test.assert(lim.admit(l, 0, 3601000, 20));
        test.assert(!lim.admit(l, 0, 3601000, 20));
    }
    return 0;
}

// Any one second sees at most the rate plus the depth, and a long run gets the rate.
fn check_long_run[&l, &t](l: &!l [int], starts: &!t [int]) -> [] int {
    let rate = 30;
    lim.init(l, 10, 8, rate);
    var now = 0;
    var n = 0;
    // the loop looks every millisecond, wanting to start as often as it may
    while now < 20000 {
        if lim.admit(l, 0, now, rate) {
            starts[n] = now;
            n = n + 1;
        }
        now = now + 1;
    }
    // 20 s at 30 a second: 600, plus the first bucket
    test.assert(n >= 600);
    test.assert(n <= 600 + lim.depth(rate));
    // no window of 1,000 ms holds more than rate + depth starts
    var i = 0;
    var worst = 0;
    while i < n {
        var j = i;
        while j < n && starts[j] < starts[i] + 1000 {
            j = j + 1;
        }
        if j - i > worst {
            worst = j - i;
        }
        i = i + 1;
    }
    test.assert(worst <= rate + lim.depth(rate));
    test.assert(worst >= rate);
    return 0;
}

fn test_over_a_long_run_the_attempts_are_the_rate_and_no_second_exceeds_rate_plus_depth[&h](heap: &!h Heap) -> [heap] int {
    let lb = box_slice(heap, lim.size(), 0);
    let sb = box_slice(heap, 20001, 0);
    borrow mut lb as &!lw in {
        borrow mut sb as &!sw in {
            check_long_run(contents(lw), contents(sw));
        }
    }
    unbox_slice(heap, lb);
    unbox_slice(heap, sb);
    return 0;
}

fn test_buckets_are_apart_and_a_cleared_slot_starts_full() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 10);
        test.assert(lim.admit(l, 0, 1000, 10));
        test.assert(!lim.admit(l, 0, 1000, 10));
        // another endpoint's bucket is its own
        test.assert(lim.admit(l, 1, 1000, 10));
        test.assert(!lim.admit(l, 1, 1000, 10));
        test.assert(lim.admit(l, 61, 1000, 10));
        lim.clear_slot(l, 0);
        test.assert(lim.admit(l, 0, 1000, 10));
        test.assert_eq(lim.held_back(l, 0), 0);
        test.assert_eq(lim.held_back(l, 1), 1);
    }
    return 0;
}

// The counter counts a wait once, not once per look; a new wait after an admitted attempt counts again.
fn test_held_back_counts_the_first_refusal_after_an_attempt_got_through() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 10);
        test.assert(lim.admit(l, 0, 0, 10));
        var t = 1;
        while t < 100 {
            test.assert(!lim.admit(l, 0, t, 10));
            t = t + 1;
        }
        test.assert_eq(lim.held_back(l, 0), 1);
        test.assert(lim.admit(l, 0, 100, 10));
        test.assert(!lim.admit(l, 0, 101, 10));
        test.assert_eq(lim.held_back(l, 0), 2);
    }
    return 0;
}

// The sleep is shortened to the time the soonest token needs, over all the endpoints held back, and no longer than it ever was.
fn test_the_loop_sleeps_until_the_soonest_token() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 100);
        lim.begin_turn(l);
        test.assert_eq(lim.wait_ms(l), 50);
        // rate 100: depth 10, a token every 10 ms
        var i = 0;
        while i < 10 {
            test.assert(lim.admit(l, 0, 1000, 100));
            i = i + 1;
        }
        test.assert(!lim.admit(l, 0, 1000, 100));
        test.assert_eq(lim.wait_ms(l), 10);
        test.assert(!lim.admit(l, 0, 1004, 100));
        test.assert_eq(lim.wait_ms(l), 6);
        // another endpoint, slower, does not lengthen it
        test.assert(lim.admit(l, 1, 1004, 1));
        test.assert(!lim.admit(l, 1, 1004, 1));
        test.assert_eq(lim.wait_ms(l), 6);
        // a turn starts again from nothing
        lim.begin_turn(l);
        test.assert_eq(lim.wait_ms(l), 50);
        // a rate so slow that the token is seconds away: the sleep is the ordinary one
        test.assert(!lim.admit(l, 1, 1005, 1));
        test.assert_eq(lim.wait_ms(l), 50);
    }
    return 0;
}

// A limit that is raised while the bucket is nearly empty takes effect at once; one that is lowered cuts the bucket to the new depth.
fn test_a_changed_rate_takes_effect_on_the_next_look() -> [] int {
    region a {
        let l = alloc_slice[a](lim.size(), 0);
        lim.init(l, 10, 8, 100);
        var i = 0;
        while i < 10 {
            test.assert(lim.admit(l, 0, 0, 100));
            i = i + 1;
        }
        test.assert(!lim.admit(l, 0, 0, 100));
        // lowered to 10: depth 1, a token per 100 ms
        test.assert(!lim.admit(l, 0, 50, 10));
        test.assert(lim.admit(l, 0, 100, 10));
        test.assert(!lim.admit(l, 0, 100, 10));
    }
    return 0;
}
