# cancho-hooks under systemd.
#
#   useradd --system --home-dir /var/lib/hooks --shell /usr/sbin/nologin hooks
#   install -d -o root -g root /opt/hooks/bin && install -m 0755 hooks /opt/hooks/bin/hooks      # from the release tarball
#   install -d -o root -g hooks -m 0750 /etc/hooks
#   install -o root -g hooks -m 0640 deploy/hooks.conf.example /etc/hooks/hooks.conf              # edit it: it holds secrets
#   install -m 0644 deploy/hooks.service /etc/systemd/system/hooks.service
#   systemctl daemon-reload && systemctl enable --now hooks
#
# What was checked and what was not (docs/runbook.md, "Hardening"): `systemd-analyze verify` and `systemd-analyze security
# --offline` pass on this file; the syscalls the service makes (a workload with PostgreSQL, a config file, POST /endpoints) were
# recorded with strace and are all inside @system-service; the binary maps no anonymous executable memory. The unit has NOT been
# run under a systemd here (no systemd in the build sandbox): the first start on a real host is the test.
[Unit]
Description=cancho-hooks webhook delivery service
Documentation=https://github.com/alpibrusl/cancho-hooks
After=network-online.target postgresql.service
Wants=network-online.target
# A service that keeps failing to start is stopped after 10 tries in 5 minutes, not restarted for ever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hooks
Group=hooks
# The settings file holds the admin token and the database password: root:hooks 0640, never world-readable. (To keep it out of the
# service user's reach altogether, `LoadCredential=hooks.conf:/etc/hooks/hooks.conf` and `--config %d/hooks.conf` work too.)
ExecStart=/opt/hooks/bin/hooks --config /etc/hooks/hooks.conf

# SIGTERM (what `systemctl stop` sends) drains: the service stops taking requests and starting attempts, lets the attempts on the wire finish for at most
# `stop-deadline-ms` (5000 unless the settings file says otherwise), flushes, closes the logs and exits 0 (docs/design.md section 34.4). TimeoutStopSec is when
# systemd gives up and sends SIGKILL, which is safe too (what was on the wire is made again at the next start, at least once) but loses the clean exit; it must be longer
# than stop-deadline-ms with room for the flush: 15 s for the default 5 s. Raise both together. A second `systemctl kill -s TERM hooks` ends the process at once.
KillSignal=SIGTERM
TimeoutStopSec=15

# Restart when it died or was killed, and when a start was refused for a reason that can pass (status 11: the port was taken;
# 20: the database was not there yet; 3 and 4 are not expected). Do NOT restart on a refusal that a restart cannot fix: 2 the
# settings, 10 and 12 a log that cannot be opened, 13 endpoints that are not valid, 14 a bad schedule, 15 to 17 a log the service does
# not understand, 18 a delivery log ahead of its events log, 19 damage in the middle of a log (a person has to look: docs/runbook.md
# section 4.7), 30 to 35 the production profile refusing an unsafe setting or mode. (docs/runbook.md section 1 lists every status.)
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2 10 12 13 14 15 16 17 18 19 21 30 31 32 33 34 35

# The data directory: /var/lib/hooks, created and owned by User, mode 0700 (`production = 1` refuses a directory or a log that the group or
# others can read or write). The two logs and endpoints.conf live there, made under the umask below.
StateDirectory=hooks
StateDirectoryMode=0700
UMask=0077

# Hardening. The service reads its settings, appends to two files in its state directory and talks TCP (clients, receivers,
# PostgreSQL); it needs nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Port 1024 or above only: put a reverse proxy in front for 80 and 443 rather than give the service a capability.

# Limits. One thread, at most 64 delivery attempts and a few hundred client connections.
LimitNOFILE=8192
TasksMax=64

# Optional, for a host where the service has no business reaching the cloud metadata address (it only ever connects to the receivers
# you configure, and `allow-private-hosts 0` already refuses link-local ones): uncomment.
#IPAddressDeny=169.254.0.0/16

# Logs go to the journal: `journalctl -u hooks`. The service writes a line at start, when it refuses to start, when it cuts a torn tail or a damaged log, when the circuit
# breaker pauses an endpoint and when it stops; nothing else (docs/runbook.md section 3.1).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hooks

[Install]
WantedBy=multi-user.target
